    "postpack": "rm -f README.md LICENSE"
  },
  "dependencies": {
    "@dishant0406/dev-to": "1.0.1",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
