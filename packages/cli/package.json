{
  "name": "@dishant0406/dev-to-cli",
  "version": "1.0.1",
  "description": "Command line interface for the dev.to / Forem API v1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "devto": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "devto",
    "dev.to",
    "forem",
    "cli"
  ],
  "scripts": {
